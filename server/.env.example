# Server Environment Variables

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/bpsmv

# JWT secret for signing authentication tokens (use a strong random string in production)
JWT_SECRET=change_this_to_a_random_string_in_production

# Login session duration in days
AUTH_SESSION_DAYS=30

# Client URL for CORS and OAuth redirects (Vite default port is 5173)
CLIENT_URL=http://localhost:5173

# Optional: comma-separated extra frontend origins for CORS
CLIENT_URLS=http://localhost:5173

# Public backend URL used for OAuth callbacks in production
API_URL=http://localhost:5000

# Use none when frontend and backend are on different production domains
COOKIE_SAME_SITE=lax

# Gift submission email destination
ADMIN_EMAIL=priyankakhasa937@gmail.com

# Optional SMTP credentials for real email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sender_email@gmail.com
SMTP_PASS=your_app_password

# Server port
PORT=5000

# Google OAuth credentials (optional - email/password works without these)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional: override the callback URL when backend and frontend run on separate domains
# GOOGLE_CALLBACK_URL=https://your-backend-domain.com/api/auth/google/callback

# Node environment
NODE_ENV=development

# Razorpay Payment Gateway (use test keys locally, live keys only in production)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=use_a_separate_random_webhook_secret
