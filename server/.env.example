# Server Environment Variables

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/bpsmv

# JWT secret for signing authentication tokens (use a strong random string in production)
JWT_SECRET=change_this_to_a_random_string_in_production

# Client URL for CORS and OAuth redirects (Vite default port is 5173)
CLIENT_URL=http://localhost:5173

# Optional: comma-separated extra frontend origins for CORS
CLIENT_URLS=http://localhost:5173

# Public backend URL used for OAuth callbacks in production
API_URL=http://localhost:5000

# Use none when frontend and backend are on different production domains
COOKIE_SAME_SITE=lax

# Server port
PORT=5000

# Google OAuth credentials (optional - email/password works without these)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Node environment
NODE_ENV=development
