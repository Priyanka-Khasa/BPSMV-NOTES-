# Client Environment Variables
# Vite exposes only env vars prefixed with VITE_ to the client

# API base URL. Set this in production if backend is not served from the same domain.
VITE_API_URL=http://localhost:5000/api

# Public Cloudflare Turnstile site key (the secret belongs only on the server)
VITE_TURNSTILE_SITE_KEY=your_public_turnstile_site_key
